{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "kosku/Dockerfile",
    "dockerContext": "kosku",
    "watchPatterns": ["kosku/**"]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/start.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
